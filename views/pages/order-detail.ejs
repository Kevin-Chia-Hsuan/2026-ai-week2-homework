<div id="app" data-order-id="<%= orderId %>" data-payment-result="<%= paymentResult %>">
  <div class="mx-auto max-w-[1440px]">
    <div class="px-5 pb-6 pt-9 md:px-16 md:pb-10 md:pt-16">
      <h1 class="font-hand text-[40px] font-bold text-cocoa md:text-[52px]">訂單詳情</h1>
    </div>

    <div v-if="loading" class="flex justify-center py-16">
      <div class="h-8 w-8 animate-spin rounded-full border-4 border-coral border-t-transparent"></div>
    </div>

    <template v-else-if="order">
      <!-- 付款結果提示 -->
      <div v-if="paymentResult && paymentMessages[paymentResult]" class="px-5 pb-6 md:px-16 md:pb-8">
        <div class="px-4 py-3.5 text-sm md:px-6 md:py-4" :class="paymentMessages[paymentResult].cls">
          {{ paymentMessages[paymentResult].text }}
        </div>
      </div>

      <div class="flex flex-col px-5 pb-14 md:flex-row md:items-start md:gap-16 md:px-16 md:pb-24">
        <!-- 左：訂單與商品 -->
        <div class="flex-1">
          <div class="flex items-center justify-between border-b border-ink pb-[18px] md:pb-6">
            <div class="flex flex-col gap-0.5 md:gap-1">
              <span class="text-xs tracking-[0.2em] text-muted">訂單編號</span>
              <span class="font-hand text-xl font-bold md:text-[30px]">{{ order.order_no }}</span>
            </div>
            <span class="rounded-full px-3.5 py-1.5 text-xs font-medium md:px-4" :class="statusMap[order.status]?.cls || 'bg-line text-ink-2'">
              {{ statusMap[order.status]?.label || order.status }}
            </span>
          </div>

          <div
            v-for="item in order.items"
            :key="item.id"
            class="flex items-center justify-between gap-4 border-b border-line py-5 md:py-6"
          >
            <div class="flex min-w-0 flex-col gap-1.5">
              <p class="font-hand text-[17px] font-bold md:text-xl">{{ item.product_name }}</p>
              <p class="text-[13px] text-muted">單價 NT$ {{ item.product_price.toLocaleString() }} × {{ item.quantity }}</p>
            </div>
            <p class="shrink-0 font-hand text-lg font-bold md:text-[22px]">NT$ {{ (item.product_price * item.quantity).toLocaleString() }}</p>
          </div>

          <div class="flex items-end justify-between pb-7 pt-[22px] md:pt-7">
            <span class="text-[15px]">總計</span>
            <span class="font-hand text-[32px] font-bold text-coral md:text-[40px]">NT$ {{ order.total_amount.toLocaleString() }}</span>
          </div>
        </div>

        <!-- 右：收件資訊與付款 -->
        <div class="flex flex-col gap-6 md:w-[440px] md:shrink-0">
          <div class="flex flex-col gap-4 border border-line bg-white p-6 md:gap-[18px] md:p-8">
            <h2 class="font-hand text-xl font-bold text-cocoa md:text-[22px]">收件資訊</h2>
            <div class="flex flex-col gap-0.5"><span class="text-xs tracking-wide text-muted">收件人</span><span class="text-[15px]">{{ order.recipient_name }}</span></div>
            <div class="flex flex-col gap-0.5"><span class="text-xs tracking-wide text-muted">Email</span><span class="break-all text-[15px]">{{ order.recipient_email }}</span></div>
            <div class="flex flex-col gap-0.5"><span class="text-xs tracking-wide text-muted">地址</span><span class="text-[15px]">{{ order.recipient_address }}</span></div>
            <div class="flex flex-col gap-0.5"><span class="text-xs tracking-wide text-muted">建立日期</span><span class="text-[15px]">{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</span></div>
          </div>

          <div v-if="order.status === 'pending'" class="flex flex-col gap-3">
            <a
              :href="'/ecpay/payment/' + order.id"
              class="flex h-[52px] items-center justify-center rounded-full bg-coral text-[15px] tracking-wide text-white transition-colors hover:bg-coral-dark"
            >
              前往付款
            </a>
            <button
              @click="checkPayment"
              :disabled="paying"
              class="h-[52px] rounded-full border border-cocoa text-[15px] tracking-wide text-cocoa transition-colors hover:bg-cocoa hover:text-white disabled:opacity-50"
            >
              {{ paying ? '查詢中...' : '查詢付款狀態' }}
            </button>
          </div>
        </div>
      </div>
    </template>
  </div>
</div>
