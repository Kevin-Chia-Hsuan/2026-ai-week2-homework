<div id="app">
  <div class="mx-auto max-w-[1440px]">
    <div class="flex items-end justify-between px-5 pb-6 pt-9 md:px-16 md:pb-10 md:pt-16">
      <h1 class="font-hand text-[40px] font-bold text-cocoa md:text-[52px]">我的訂單</h1>
      <p v-if="orders.length" class="text-[13px] text-muted md:text-sm">共 {{ orders.length }} 筆訂單</p>
    </div>

    <div v-if="loading" class="flex justify-center py-16">
      <div class="h-8 w-8 animate-spin rounded-full border-4 border-coral border-t-transparent"></div>
    </div>

    <div v-else-if="orders.length === 0" class="px-5 py-16 text-center md:px-16">
      <p class="font-hand text-2xl font-bold text-cocoa">尚無訂單</p>
      <p class="mb-6 mt-2 text-sm text-ink-2">快去選購喜歡的花束吧！</p>
      <a href="/" class="inline-flex h-12 items-center rounded-full bg-coral px-8 text-sm text-white transition-colors hover:bg-coral-dark">去逛逛</a>
    </div>

    <div v-else class="px-5 pb-14 md:px-16 md:pb-24">
      <!-- 表頭（桌面） -->
      <div class="hidden items-center gap-6 border-b border-ink pb-3.5 text-xs tracking-[0.2em] text-muted md:flex">
        <span class="w-[360px]">訂單編號</span>
        <span class="w-[200px]">建立日期</span>
        <span class="w-[200px]">狀態</span>
        <span class="flex-1 text-right">金額</span>
        <span class="w-6"></span>
      </div>
      <div class="border-t border-ink md:hidden"></div>

      <a
        v-for="order in orders"
        :key="order.id"
        :href="'/orders/' + order.id"
        class="group flex flex-col gap-3 border-b border-line py-[22px] transition-colors hover:bg-peach/40 md:flex-row md:items-center md:gap-6 md:py-7"
      >
        <div class="flex items-center justify-between md:contents">
          <p class="font-hand text-lg font-bold md:w-[360px] md:text-[22px]">{{ order.order_no }}</p>
          <span
            class="rounded-full px-3.5 py-1.5 text-xs font-medium md:order-3 md:w-fit"
            :class="statusMap[order.status]?.cls || 'bg-line text-ink-2'"
          >
            {{ statusMap[order.status]?.label || order.status }}
          </span>
        </div>
        <div class="flex items-center justify-between md:contents">
          <p class="text-[13px] text-muted md:order-2 md:w-[200px] md:text-sm md:text-ink-2">{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</p>
          <div class="flex items-center gap-2 md:order-4 md:flex-1 md:justify-end md:gap-6">
            <span class="font-hand text-xl font-bold md:text-[22px]">NT$ {{ order.total_amount.toLocaleString() }}</span>
            <svg class="text-cocoa transition-transform group-hover:translate-x-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </div>
        </div>
      </a>
    </div>
  </div>
</div>
