<div id="app">
  <div class="mx-auto max-w-[1440px]">
    <div class="flex items-end justify-between px-5 pb-5 pt-9 md:px-16 md:pb-10 md:pt-16">
      <h1 class="font-hand text-[40px] font-bold text-cocoa md:text-[52px]">購物車</h1>
      <p v-if="items.length" class="text-[13px] text-muted md:text-sm">共 {{ items.length }} 件商品</p>
    </div>

    <div v-if="loading" class="flex justify-center py-16">
      <div class="h-8 w-8 animate-spin rounded-full border-4 border-coral border-t-transparent"></div>
    </div>

    <div v-else-if="items.length === 0" class="px-5 py-16 text-center md:px-16">
      <p class="font-hand text-2xl font-bold text-cocoa">購物車是空的</p>
      <p class="mb-6 mt-2 text-sm text-ink-2">快去挑選喜歡的花束吧！</p>
      <a href="/" class="inline-flex h-12 items-center rounded-full bg-coral px-8 text-sm text-white transition-colors hover:bg-coral-dark">去逛逛</a>
    </div>

    <template v-else>
      <div class="flex flex-col md:flex-row md:items-start md:gap-16 md:px-16 md:pb-24">
        <div class="flex-1">
          <!-- 免運提示 -->
          <div v-if="total < 500" class="flex items-center gap-2.5 bg-peach px-5 py-3.5 text-sm text-coral-dark md:px-[22px] md:py-4">
            <svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
            再買 NT$ {{ (500 - total).toLocaleString() }} 即可享免運費！
          </div>
          <div v-else class="flex items-center gap-2.5 bg-sage/20 px-5 py-3.5 text-sm text-emerald-900 md:px-[22px] md:py-4">
            <svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            已達免運門檻！
          </div>

          <!-- 表頭（桌面） -->
          <div class="hidden items-center border-b border-ink pb-3.5 pt-6 text-xs tracking-[0.2em] text-muted md:flex">
            <span class="flex-1">商品</span>
            <span class="w-[130px] text-center">數量</span>
            <span class="w-[130px] text-right">小計</span>
          </div>

          <!-- 品項 -->
          <div class="px-5 md:px-0">
            <div
              v-for="item in items"
              :key="item.id"
              class="flex items-center gap-4 border-b border-line py-6 md:gap-6 md:py-7"
            >
              <img
                :src="item.product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=200'"
                :alt="item.product.name"
                class="h-[120px] w-24 shrink-0 object-cover md:h-[130px] md:w-[110px]"
              />
              <div class="flex min-w-0 flex-1 flex-col gap-2 md:flex-row md:items-center md:gap-6">
                <div class="flex min-w-0 flex-1 flex-col gap-1.5 md:gap-2">
                  <h3 class="font-hand text-[17px] font-bold text-ink md:text-xl">{{ item.product.name }}</h3>
                  <p class="font-hand text-base text-coral md:text-lg">NT$ {{ item.product.price.toLocaleString() }}</p>
                  <button
                    @click="confirmDelete(item.id)"
                    class="hidden h-8 items-center gap-1.5 self-start text-[13px] text-muted transition-colors hover:text-coral md:flex"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    移除
                  </button>
                </div>

                <div class="flex items-center gap-3 md:w-[130px] md:justify-center">
                  <div class="flex items-center rounded-full border border-line">
                    <button
                      @click="updateQuantity(item.id, item.quantity - 1)"
                      :disabled="item.quantity <= 1"
                      class="flex h-11 w-11 items-center justify-center font-hand text-lg text-ink-2 disabled:opacity-40 md:h-9 md:w-9"
                      aria-label="減少數量"
                    >&minus;</button>
                    <span class="flex h-11 w-7 items-center justify-center font-hand text-base font-bold md:h-9">{{ item.quantity }}</span>
                    <button
                      @click="updateQuantity(item.id, item.quantity + 1)"
                      :disabled="item.quantity >= item.product.stock"
                      class="flex h-11 w-11 items-center justify-center font-hand text-lg text-ink-2 disabled:cursor-not-allowed disabled:opacity-40 md:h-9 md:w-9"
                      aria-label="增加數量"
                    >+</button>
                  </div>
                  <button @click="confirmDelete(item.id)" class="flex h-11 w-11 items-center justify-center text-muted hover:text-coral md:hidden" aria-label="移除商品">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </div>
              </div>
              <p class="hidden w-[130px] text-right font-hand text-xl font-bold md:block">
                NT$ {{ (item.product.price * item.quantity).toLocaleString() }}
              </p>
            </div>
          </div>
        </div>

        <!-- 訂單摘要 -->
        <aside class="flex flex-col gap-[18px] bg-cocoa p-7 text-paper md:w-[420px] md:shrink-0 md:gap-5 md:p-9">
          <h2 class="font-hand text-[22px] font-bold md:text-2xl">訂單摘要</h2>
          <div class="flex justify-between text-sm text-paper/80">
            <span>商品小計</span>
            <span class="text-paper">NT$ {{ total.toLocaleString() }}</span>
          </div>
          <div class="flex justify-between text-sm text-paper/80">
            <span>運費</span>
            <span class="text-paper">{{ total >= 500 ? '免運' : 'NT$ 150' }}</span>
          </div>
          <hr class="border-white/20">
          <div class="flex items-end justify-between">
            <span class="text-[15px]">總計</span>
            <span class="font-hand text-[32px] font-bold md:text-4xl">NT$ {{ (total + (total >= 500 ? 0 : 150)).toLocaleString() }}</span>
          </div>
          <button
            @click="goCheckout"
            class="h-[52px] w-full rounded-full bg-coral text-[15px] tracking-wide text-white transition-colors hover:bg-coral-dark"
          >
            前往結帳
          </button>
          <a href="/" class="hidden text-center text-[13px] text-paper/80 underline underline-offset-4 hover:text-white md:block">繼續選購</a>
        </aside>
      </div>
    </template>
  </div>

  <!-- Confirm Dialog -->
  <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-ink/50" @click="confirmVisible = false"></div>
    <div class="relative mx-4 w-full max-w-sm bg-paper p-7 text-center">
      <h3 class="mb-2 font-hand text-xl font-bold text-cocoa">確認移除</h3>
      <p class="mb-6 text-sm text-ink-2">確定要從購物車中移除這個商品嗎？</p>
      <div class="flex justify-center gap-3">
        <button @click="confirmVisible = false" class="h-11 rounded-full border border-line px-6 text-sm text-ink-2 hover:bg-peach">取消</button>
        <button @click="handleDelete" class="h-11 rounded-full bg-coral px-6 text-sm text-white hover:bg-coral-dark">確認移除</button>
      </div>
    </div>
  </div>
</div>
