<header class="sticky top-0 z-50 bg-paper border-b border-line">
  <div class="mx-auto flex h-16 md:h-[84px] max-w-[1440px] items-center justify-between px-5 md:px-16">
    <!-- 桌面：左側連結 -->
    <nav class="hidden md:flex md:w-[300px] items-center gap-9 text-sm tracking-wide text-ink">
      <a href="/" class="hover:text-coral transition-colors">商品列表</a>
      <a id="orders-link" href="/orders" class="hover:text-coral transition-colors" style="display: none;">我的訂單</a>
    </nav>

    <!-- 手機：漢堡按鈕 -->
    <button
      id="menu-toggle"
      type="button"
      class="md:hidden -ml-2 flex h-11 w-11 items-center justify-center text-ink"
      aria-label="開啟選單"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <a href="/" class="flex h-11 items-center font-hand text-[22px] md:text-[26px] font-bold tracking-[0.2em] text-cocoa">花漾生活</a>

    <div class="flex items-center justify-end gap-6 md:w-[300px]">
      <a href="/cart" class="relative flex h-11 items-center gap-1.5 text-sm text-ink hover:text-coral transition-colors" aria-label="購物車">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="hidden md:inline">購物車</span>
        <span
          id="cart-badge"
          class="bg-coral text-white text-[10px] font-bold rounded-full w-[18px] h-[18px] items-center justify-center"
          style="display: none;"
        ></span>
      </a>
      <div id="auth-nav" class="hidden md:flex items-center gap-4 text-sm">
        <a href="/login" class="bg-cocoa text-white px-[22px] py-[9px] rounded-full text-[13px] tracking-wide hover:bg-coral transition-colors">登入</a>
      </div>
    </div>
  </div>

  <!-- 手機：展開選單 -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-line bg-paper px-5 pb-5">
    <nav class="flex flex-col text-base text-ink">
      <a href="/" class="flex h-12 items-center border-b border-line">商品列表</a>
      <a id="orders-link-m" href="/orders" class="h-12 items-center border-b border-line" style="display: none;">我的訂單</a>
    </nav>
    <div id="auth-nav-m" class="flex flex-wrap items-center gap-4 pt-4 text-sm">
      <a href="/login" class="bg-cocoa text-white px-6 py-3 rounded-full text-sm">登入</a>
    </div>
  </div>
</header>
